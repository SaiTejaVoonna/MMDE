{
  "name": "mmde",
  "version": "0.0.1",
  "private": true,
  "description": "Media Music Discovery Engine - personal prototype (not for distribution)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"tests/*.test.ts\"",
    "slime": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/app/cli.ts data/seeds/slime.sample.json",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server/main.ts",
    "start:offline": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server/main.ts --offline",
    "build:web": "node scripts/build-web.mjs",
    "setup": "node scripts/setup-env.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
