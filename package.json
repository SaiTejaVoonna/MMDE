{
  "name": "mmde",
  "version": "0.0.1",
  "private": true,
  "description": "Media Music Discovery Engine - personal prototype (not for distribution)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.ts\"",
    "slime": "node src/app/cli.ts data/seeds/slime.sample.json",
    "start": "node src/server/main.ts",
    "start:offline": "node src/server/main.ts --offline",
    "build:web": "node scripts/build-web.mjs",
    "build:search": "node search/build.mjs",
    "test:search": "node --test \"search/tests/*.test.js\""
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
