# MMDE server configuration. Copy to .env for local use (git-ignored). On Railway set these as Variables instead.
# NEVER commit real values. Only the server reads these; they are never sent to the browser.

# TMDB "API Read Access Token" (v4 bearer token) from themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=

# Exact origin(s) of a separately hosted frontend allowed to call this API (comma separated, no trailing path).
# Example: https://saitejavoonna.github.io
MMDE_WEB_ORIGIN=

# Contact string put in the User-Agent sent to MusicBrainz/AnimeThemes (e.g. an email or repo URL).
MMDE_CONTACT=

# Optional, costs money per call: enables the Wikipedia+AI extractor. Leave empty on a public server.
ANTHROPIC_API_KEY=

# Set to 1 behind a reverse proxy so per-client rate limits use X-Forwarded-For (auto-enabled on Railway).
# PORT is provided by the platform; locally it defaults to 8787.
MMDE_TRUST_PROXY=
